+	for format in [ImageFormat::Lz4, ImageFormat::Lzf, ImageFormat::Lzfse, ImageFormat::Png, ImageFormat::Jpg] {
+		if supported.contains(&(format as i32)) { return format; }
+	}
+	ImageFormat::Png
