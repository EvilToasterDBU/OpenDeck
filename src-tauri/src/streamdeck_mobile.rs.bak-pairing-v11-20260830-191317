}

fn mobile_state_path_current_v47() -> std::path::PathBuf {
	if let Some(xdg) = std::env::var_os("XDG_CONFIG_HOME") {
		return std::path::PathBuf::from(xdg).join("opendeck").join("streamdeck-mobile.json");
	}
	if let Some(home) = std::env::var_os("HOME") {
		return std::path::PathBuf::from(home).join(".config").join("opendeck").join("streamdeck-mobile.json");
	}
	std::path::PathBuf::from("streamdeck-mobile.json")
}

const CURRENT_V47_DESKTOP_NAME: &str = "OpenDeck";
const CURRENT_V47_MOBILE_DEVICE_NAME: &str = "Open Deck Mobile";

async fn load_mobile_state_current_v47() -> anyhow::Result<PersistedMobileStateCurrentV47> {
	match tokio::fs::read(mobile_state_path_current_v47()).await {
		Ok(bytes) => Ok(serde_json::from_slice(&bytes).unwrap_or_default()),
		Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(Default::default()),
		Err(e) => Err(e.into()),
	}
}

async fn save_mobile_state_current_v47(state: &PersistedMobileStateCurrentV47) -> anyhow::Result<()> {
	let path = mobile_state_path_current_v47();
	if let Some(parent) = path.parent() {
		tokio::fs::create_dir_all(parent).await?;
	}
	let tmp = path.with_extension("json.tmp");
	tokio::fs::write(&tmp, serde_json::to_vec_pretty(state)?).await?;
	tokio::fs::rename(tmp, path).await?;
	Ok(())
}

async fn persist_mobile_approval_current_v47(fingerprint: &str, public_key: &[u8], rows: u8, columns: u8) -> anyhow::Result<()> {
	if public_key.len() != 32 {
		return Err(anyhow::anyhow!("invalid Mobile public key length {}", public_key.len()));
	}
	let mut state = load_mobile_state_current_v47().await?;
	let name = state
		.devices
		.iter()
		.find(|d| d.fingerprint == fingerprint)
		.map(|d| d.name.clone())
		.unwrap_or_else(|| CURRENT_V47_MOBILE_DEVICE_NAME.to_owned());
	let rec = PersistedMobileDeviceCurrentV47 {
		fingerprint: fingerprint.to_owned(),
		public_key_b64: base64::engine::general_purpose::STANDARD.encode(public_key),
		name,
		rows: rows.max(1),
		columns: columns.max(1),
	};
	if let Some(d) = state.devices.iter_mut().find(|d| d.fingerprint == fingerprint) {
		*d = rec
	} else {
		state.devices.push(rec)
	}
	save_mobile_state_current_v47(&state).await
}

async fn persist_mobile_layout_current_v47(device_id: &str, rows: u8, columns: u8) -> anyhow::Result<()> {
	let Some(fp) = device_id.strip_prefix("sdm-") else {
		return Ok(());
	};
	let mut state = load_mobile_state_current_v47().await?;
	if let Some(d) = state.devices.iter_mut().find(|d| d.fingerprint == fp) {
		d.rows = rows.max(1);
		d.columns = columns.max(1);
		save_mobile_state_current_v47(&state).await?;
	}
	Ok(())
}

async fn restore_mobile_devices_current_v47() -> anyhow::Result<()> {
	let state = load_mobile_state_current_v47().await?;
	for d in state.devices {
		let key = match base64::engine::general_purpose::STANDARD.decode(d.public_key_b64.as_bytes()) {
			Ok(k) if k.len() == 32 => k,
			Ok(k) => {
				log::warn!("[VSD2] saved Mobile {} has invalid key length {}", d.fingerprint, k.len());
				continue;
			}
			Err(e) => {
				log::warn!("[VSD2] cannot decode saved Mobile key {}: {}", d.fingerprint, e);
				continue;
			}
		};
		CLIENT_PUBLIC_KEYS.write().await.insert(d.fingerprint.clone(), key);
		AUTHENTICATED_CLIENTS.write().await.insert(d.fingerprint.clone());
		ensure_mobile_device(&d.fingerprint, &d.name, d.rows.max(1), d.columns.max(1)).await?;
		log::info!(
			"[VSD2] restored saved Mobile device id={} name={:?} layout={}x{}",
			mobile_device_id(&d.fingerprint),
			d.name,
			d.rows,
			d.columns
		);
	}
	Ok(())
}

