/// Temporary diagnostic log for Stream Deck Mobile pairing.
/// This deliberately lives outside the normal application log so the complete
/// pairing lifecycle can be collected without relying on terminal scrollback.
static MOBILE_DEBUG_LOG_RESET: OnceLock<()> = OnceLock::new();

fn mobile_debug_log(event: &str) {
	let path = mobile_state_path_current_v47()
		.parent()
		.map(|p| p.join("streamdeck-mobile-debug.log"))
		.unwrap_or_else(|| std::path::PathBuf::from("streamdeck-mobile-debug.log"));
	MOBILE_DEBUG_LOG_RESET.get_or_init(|| {
		if let Some(parent) = path.parent() {
			let _ = std::fs::create_dir_all(parent);
		}
		let _ = std::fs::OpenOptions::new().create(true).write(true).truncate(true).open(&path);
	});

	let timestamp = SystemTime::now()
		.duration_since(UNIX_EPOCH)
		.map(|d| format!("{}.{}", d.as_secs(), d.subsec_millis()))
		.unwrap_or_else(|_| "unknown".to_owned());
	if let Some(parent) = path.parent() {
		let _ = std::fs::create_dir_all(parent);
	}
	if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(&path) {
		let _ = writeln!(file, "[{timestamp}] {event}");
	}
}

