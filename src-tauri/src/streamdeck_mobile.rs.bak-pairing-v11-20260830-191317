static CLIENT_SESSION_SEQ: AtomicU64 = AtomicU64::new(1);

#[derive(Clone)]
struct ClientHandle {
	tx: mpsc::Sender<WsMessage>,
	session: u64,
	encrypt: bool,
}

fn next_client_session() -> u64 {
	CLIENT_SESSION_SEQ.fetch_add(1, Ordering::Relaxed)
}

async fn attach_mobile_session(device_id: &str, tx: mpsc::Sender<WsMessage>, encrypt: bool) -> u64 {
	let session = next_client_session();
	CLIENTS.write().await.insert(device_id.to_owned(), ClientHandle { tx, session, encrypt });
	log::info!("[VSD2] attached icon session device={} session={} encrypt={}", device_id, session, encrypt);
	session
}

async fn detach_mobile_session(device_id: &str, session: u64) {
	let mut clients = CLIENTS.write().await;
	if clients.get(device_id).map(|client| client.session) == Some(session) {
		clients.remove(device_id);
		log::info!("[VSD2] detached icon session device={} session={}", device_id, session);
	}
}

fn server_secret_key() -> SecretKey {
	static SERVER_SECRET: OnceLock<SecretKey> = OnceLock::new();

	SERVER_SECRET
		.get_or_init(|| {
			let machine_id = std::fs::read_to_string("/etc/machine-id").unwrap_or_default();

			let mut h = Blake2b512::new();
			h.update(b"OpenDeck Stream Deck Mobile VSD2 server key v1");
			h.update(hostname_string().as_bytes());
			h.update(machine_id.trim().as_bytes());

			let mut bytes = [0u8; 32];
			bytes.copy_from_slice(&h.finalize()[..32]);
			SecretKey::from(bytes)
		})
		.clone()
}

fn server_key() -> &'static [u8] {
	static SERVER_PUBLIC: OnceLock<Vec<u8>> = OnceLock::new();

	SERVER_PUBLIC.get_or_init(|| server_secret_key().public_key().as_bytes().to_vec()).as_slice()
}

fn hostname_string() -> String {
	// Use the OS hostname for the name shown in Stream Deck Mobile's
	// "Available computers" list. HOSTNAME may be overridden by a launcher.
	if let Ok(hostname) = std::fs::read_to_string("/etc/hostname") {
		let hostname = hostname.trim();
		if !hostname.is_empty() {
			return hostname.to_owned();
		}
	}
	std::env::var("COMPUTERNAME")
		.or_else(|_| std::env::var("HOSTNAME"))
		.map(|name| name.trim().to_owned())
		.and_then(|name| if name.is_empty() { Err(std::env::VarError::NotPresent) } else { Ok(name) })
		.unwrap_or_else(|_| "OpenDeck".to_owned())
}

fn client_key_id(key: &[u8]) -> String {
	// VSD2 user-facing verification code: first 6 hex characters of
	// BLAKE2b-256(publicKey).
	let mut h = Blake2b::<U32>::new();
	h.update(key);
	hex6(&h.finalize())
}

fn hex6(bytes: &[u8]) -> String {
	bytes.iter().take(3).map(|b| format!("{b:02x}")).collect()
}

fn hex16(bytes: &[u8]) -> String {
	bytes.iter().take(16).map(|b| format!("{b:02x}")).collect()
}

fn local_ipv4() -> Option<Ipv4Addr> {
	let socket = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).ok()?;
	socket.connect((Ipv4Addr::new(8, 8, 8, 8), 53)).ok()?;
	match socket.local_addr().ok()?.ip() {
		IpAddr::V4(ip) if !ip.is_loopback() => Some(ip),
		_ => None,
	}
}

fn endpoint_addresses() -> Vec<String> {
	local_ipv4().map(|ip| vec![ip.to_string()]).unwrap_or_else(|| vec!["127.0.0.1".to_owned()])
}

