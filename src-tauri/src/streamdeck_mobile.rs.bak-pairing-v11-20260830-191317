#[tauri::command]
pub async fn streamdeck_mobile_resolve_pairing(fingerprint: String, approve: bool) -> Result<(), String> {
	mobile_debug_log(&format!("PAIRING_RESOLVE_BEGIN fingerprint={} approve={}", fingerprint, approve));
	let public_key = CLIENT_PUBLIC_KEYS
		.read()
		.await
		.get(&fingerprint)
		.cloned()
		.ok_or_else(|| format!("No public key for pending Mobile {fingerprint}"))?;

	{
		let mut pending = PENDING_PAIRINGS.write().await;
		if let Some(pairing) = pending.get_mut(&fingerprint) {
			pairing.approved = approve;
			log::info!("[VSD2] desktop pairing decision for {}: approve={}", fingerprint, approve);
			mobile_debug_log(&format!("PAIRING_PENDING_UPDATED fingerprint={} approve={}", fingerprint, approve));
		} else if approve && AUTHENTICATED_CLIENTS.read().await.contains(&fingerprint) {
			// Idempotent approval: the frontend can issue the same decision
			// more than once while the Mobile client reconnects.
			return Ok(());
		} else {
			return Err(format!("No pending pairing for fingerprint {fingerprint}"));
		}
	}

	if approve {
		// Trust is persisted independently of the discovery WebSocket. The
		// Mobile app can close that socket immediately after displaying the
		// verification code.
		AUTHENTICATED_CLIENTS.write().await.insert(fingerprint.clone());
		persist_mobile_approval_current_v47(&fingerprint, &public_key, DEFAULT_ROWS, DEFAULT_COLS)
			.await
			.map_err(|e| e.to_string())?;

		// Approval is complete. Remove the transient prompt immediately so
		// the UI cannot issue repeated approvals for the same request.
		PENDING_PAIRINGS.write().await.remove(&fingerprint);

		log::info!("[VSD2] desktop approval completed: fingerprint={} trust_persisted=true hostname={}", fingerprint, hostname_string());
		mobile_debug_log(&format!("[VSD2] desktop approval completed: fingerprint={} hostname={}", fingerprint, hostname_string()));
		mobile_debug_log(&format!("PAIRING_APPROVED_TRUST_ONLY fingerprint={} next=mobile_reconnect_or_authenticate", fingerprint));
	} else {
		PENDING_PAIRINGS.write().await.remove(&fingerprint);
		mobile_debug_log(&format!("PAIRING_REJECTED fingerprint={}", fingerprint));
	}

	mobile_debug_log(&format!("PAIRING_RESOLVE_END fingerprint={} approve={}", fingerprint, approve));
	Ok(())
}

#[derive(Clone, serde::Serialize)]
pub struct SavedMobileDevice {
	pub fingerprint: String,
	pub device_id: String,
	pub name: String,
	pub rows: u8,
	pub columns: u8,
}

#[tauri::command]
pub async fn streamdeck_mobile_saved_devices() -> Result<Vec<SavedMobileDevice>, String> {
	let state = load_mobile_state_current_v47().await.map_err(|e| e.to_string())?;
	Ok(state
		.devices
		.into_iter()
		.map(|device| SavedMobileDevice {
			fingerprint: device.fingerprint.clone(),
			device_id: mobile_device_id(&device.fingerprint),
			name: device.name,
			rows: device.rows,
			columns: device.columns,
		})
		.collect())
}

#[tauri::command]
pub async fn streamdeck_mobile_remove_device(fingerprint: String) -> Result<(), String> {
	let device_id = mobile_device_id(&fingerprint);

	PENDING_PAIRINGS.write().await.remove(&fingerprint);
	AUTHENTICATED_CLIENTS.write().await.remove(&fingerprint);
	CLIENT_PUBLIC_KEYS.write().await.remove(&fingerprint);

	let mut state = load_mobile_state_current_v47().await.map_err(|e| e.to_string())?;
	let old_len = state.devices.len();
	state.devices.retain(|device| device.fingerprint != fingerprint);
	if state.devices.len() == old_len {
		return Err(format!("No saved Mobile device {fingerprint}"));
	}
	save_mobile_state_current_v47(&state).await.map_err(|e| e.to_string())?;

	KEYPAD_CONFIGS.write().await.remove(&device_id);
	MOBILE_IMAGE_CACHE.write().await.remove(&device_id);
	CLIENTS.write().await.remove(&device_id);

	deregister_open_deck_device(&device_id).await;
	crate::events::frontend::update_devices().await;

	log::info!("[VSD2] removed saved Mobile device: fingerprint={} device_id={}", fingerprint, device_id);
	Ok(())
}

#[tauri::command]
pub async fn streamdeck_mobile_set_device_name(fingerprint: String, name: String) -> Result<(), String> {
	let mut state = load_mobile_state_current_v47().await.map_err(|e| e.to_string())?;
	let Some(device) = state.devices.iter_mut().find(|device| device.fingerprint == fingerprint) else {
		return Err(format!("No saved Mobile device {fingerprint}"));
	};
	device.name = name.trim().to_owned();
	if device.name.is_empty() {
		device.name = CURRENT_V47_MOBILE_DEVICE_NAME.to_owned();
	}
	let new_name = device.name.clone();
	save_mobile_state_current_v47(&state).await.map_err(|e| e.to_string())?;
	if let Some(mut info) = crate::shared::DEVICES.get_mut(&mobile_device_id(&fingerprint)) {
		info.name = new_name;
	}
	crate::events::frontend::update_devices().await;
	Ok(())
}

/// Returns true when `device` belongs to this backend.
pub fn is_mobile_device(device: &str) -> bool {
	device.starts_with("sdm-")
}

pub async fn start() {
	if let Err(error) = restore_mobile_devices_current_v47().await {
		log::warn!("[VSD2] failed to restore saved Mobile devices: {}", error);
	}

	if STARTED.set(()).is_err() {
		return;
	}

	tokio::spawn(async {
		if let Err(error) = run_server().await {
			log::error!("Stream Deck Mobile server stopped: {error}");
		}
	});

	tokio::spawn(async {
		run_mdns_announcer().await;
	});
}

async fn run_server() -> anyhow::Result<()> {
	let listener_legacy = TcpListener::bind(("0.0.0.0", LEGACY_PORT)).await?;
	let listener_v2 = TcpListener::bind(("0.0.0.0", PORT)).await?;

	log::info!("Stream Deck Mobile legacy/session listener listening on 0.0.0.0:{LEGACY_PORT}");
	log::info!("Stream Deck Mobile VSD2 server listening on 0.0.0.0:{PORT}");

	loop {
		tokio::select! {
			result = listener_legacy.accept() => {
				let (stream, peer) = result?;
				log::info!("[VSD2] incoming Mobile legacy/session connection from {peer}");
				tokio::spawn(async move {
					if let Err(error) = handle_client(stream, peer, true).await {
						log::debug!("Stream Deck Mobile legacy/session client {peer} disconnected: {error}");
					}
				});
			}
			result = listener_v2.accept() => {
				let (stream, peer) = result?;
				tokio::spawn(async move {
					if let Err(error) = handle_client(stream, peer, false).await {
						log::debug!("Stream Deck Mobile VSD2 client {peer} disconnected: {error}");
					}
				});
			}
		}
	}
}

async fn handle_client(stream: TcpStream, peer: SocketAddr, legacy_connection: bool) -> anyhow::Result<()> {
	mobile_debug_log(&format!("WS_START peer={} legacy={}", peer, legacy_connection));
	let websocket = tokio_tungstenite::accept_async(stream).await?;
	log::info!("[VSD2] WebSocket handshake completed for {peer}");
	mobile_debug_log(&format!("WS_HANDSHAKE peer={} legacy={}", peer, legacy_connection));

	let (mut ws_write, mut ws_read) = websocket.split();
	let (ws_tx, mut ws_rx) = mpsc::channel::<WsMessage>(256);

	let writer = tokio::spawn(async move {
		while let Some(message) = ws_rx.recv().await {
			if let Err(error) = ws_write.send(message).await {
				log::error!("[VSD2] WebSocket writer failed: {error}");
				return Err(error);
			}
		}
		Ok::<(), tokio_tungstenite::tungstenite::Error>(())
	});

	// Stream Deck Mobile closes a quiet connection after roughly 10 seconds.
	// The VSD2 socket therefore needs server-side traffic even while the
	// client is waiting for authentication. Use WebSocket Ping frames every
	// 2 seconds; this is independent of the encrypted VSD2 protobuf layer.
	let heartbeat_tx = ws_tx.clone();
	let heartbeat = tokio::spawn(async move {
		let mut interval = tokio::time::interval(Duration::from_secs(2));
		loop {
			interval.tick().await;
			if heartbeat_tx.send(WsMessage::Ping(Vec::new().into())).await.is_err() {
				break;
			}
		}
	});

	let mut device_id: Option<String> = None;
	let mut client_fingerprint: Option<String> = None;
	let mut authenticated = false;
	let mut attached_session: Option<(String, u64)> = None;

	while let Some(message) = ws_read.next().await {
		match message? {
			WsMessage::Binary(payload) => {
				log::debug!("[VSD2] RX binary frame: {} bytes from {peer}", payload.len());

				let client = match ClientMessage::decode(payload.as_ref()) {
					Ok(client) => client,
					Err(error) => {
						// These 42/44-byte frames are encrypted VSD2 ClientMessage frames.
						// Layout observed from the Mobile client:
						//   24-byte XSalsa20 nonce + ciphertext + 16-byte Poly1305 tag.
						log::debug!("[VSD2] RX encrypted auth frame from {peer}: {} bytes: {error}", payload.len());
						log::debug!("[VSD2] RAW RX {peer}: {}", payload.iter().map(|b| format!("{b:02x}")).collect::<Vec<_>>().join(" "));

						if payload.len() >= 24 + 16 {
							if let Some(client_key) = client_fingerprint.as_ref() {
								// Use the actual 32-byte public key received in HelloFromClient.
								let peer_public = match CLIENT_PUBLIC_KEYS.read().await.get(client_key) {
									Some(key) => key.clone(),
									None => {
										log::warn!("[VSD2] no stored public key for {client_key}");
										continue;
									}
								};

								if peer_public.len() == 32 {
									let mut nonce_bytes = [0u8; 24];
									nonce_bytes.copy_from_slice(&payload[..24]);
									let nonce = crypto_box::aead::generic_array::GenericArray::from_slice(&nonce_bytes);

									let peer_pk = PublicKey::from(<[u8; 32]>::try_from(peer_public.as_slice()).unwrap());
									let boxed = SalsaBox::new(&peer_pk, &server_secret_key());

									match boxed.decrypt(nonce, &payload[24..]) {
										Ok(plaintext) => {
											log::info!("[VSD2] decrypted authentication payload from {peer}: {} bytes", plaintext.len());

											match ClientMessage::decode(plaintext.as_slice()) {
												Ok(ClientMessage {
													payload: Some(client_message::Payload::Authenticate(auth)),
												}) => {
													let key_id = client_key.clone();
													mobile_debug_log(&format!("AUTH_RX_ENCRYPTED peer={} fingerprint={} request_id={}", peer, key_id, auth.request_id));

													// A single Mobile app opens several WebSocket sessions.
													// Once this public key has been approved, subsequent
													// Authenticate messages from that same Mobile identity
													// must not create another desktop prompt.
													if AUTHENTICATED_CLIENTS.read().await.contains(&key_id) {
														log::info!(
															"[VSD2] already-authenticated Mobile client {} requested authentication again (request_id={}); sending OK without another prompt",
															key_id,
															auth.request_id
														);

														// The Mobile client is not supposed to perform a second
														// approval step here. Desktop approval completes pairing,
														// and OpenDeck should create the virtual Stream Deck now.

														{
															let stored_key = CLIENT_PUBLIC_KEYS
																.read()
																.await
																.get(&key_id)
																.cloned()
																.ok_or_else(|| anyhow::anyhow!("No stored public key for trusted Mobile {key_id}"))?;
															let peer_key = PublicKey::from(
																<[u8; 32]>::try_from(stored_key.as_slice()).map_err(|_| anyhow::anyhow!("Stored Mobile public key has invalid length"))?,
															);
															let cipher = SalsaBox::new(&peer_key, &server_secret_key());

															send_virtual_device_list(&ws_tx, &cipher, &key_id).await?;
														}

														let response = ok(auth.request_id).encode_to_vec();
														let nonce = SalsaBox::generate_nonce(&mut OsRng);
														match boxed.encrypt(&nonce, response.as_slice()) {
															Ok(ciphertext) => {
																let mut frame = Vec::with_capacity(24 + ciphertext.len());
																frame.extend_from_slice(nonce.as_slice());
																frame.extend_from_slice(&ciphertext);
																ws_tx.send(WsMessage::Binary(frame.into())).await?;
															}
															Err(error) => {
																log::error!("[VSD2] failed to encrypt repeated authentication OK for {peer}: {error:?}");
															}
														}

														continue;
													}

													{
														let mut pending = PENDING_PAIRINGS.write().await;
														pending.entry(key_id.clone()).or_insert_with(|| PendingPairing {
															fingerprint: key_id.clone(),
															name: CURRENT_V47_MOBILE_DEVICE_NAME.to_owned(),
															peer: peer.to_string(),
															approved: false,
														});
													}

													log::info!("[VSD2] decrypted Authenticate from {peer}: request_id={} verification_code={}", auth.request_id, key_id);

													log::info!("[VSD2] desktop approval requested from {peer}: verification_code={}", key_id);

													log::info!("[VSD2] IN_APP_APPROVAL_REQUIRED code={} peer={}", key_id, peer);

													let approved = tokio::time::timeout(Duration::from_secs(120), async {
														loop {
															match PENDING_PAIRINGS.read().await.get(&key_id).cloned() {
																Some(pairing) if pairing.approved => break true,
																Some(_) => {}
																None => break false,
															}
															tokio::time::sleep(Duration::from_millis(100)).await;
														}
													})
													.await
													.unwrap_or(false);

													if approved {
														authenticated = true;
														AUTHENTICATED_CLIENTS.write().await.insert(key_id.clone());

														let approved_key = CLIENT_PUBLIC_KEYS
															.read()
															.await
															.get(&key_id)
															.cloned()
															.ok_or_else(|| anyhow::anyhow!("No public key for approved Mobile {key_id}"))?;
														persist_mobile_approval_current_v47(&key_id, &approved_key, DEFAULT_ROWS, DEFAULT_COLS).await?;

														PENDING_PAIRINGS.write().await.remove(&key_id);

														log::info!(
															"[VSD2] Mobile identity {} is now TRUSTED; future HelloFromClient replies will use clientNeedsAuthentication=false",
															key_id
														);

														// Desktop approval establishes trust only. The runtime
														// virtual Stream Deck is created by OpenVirtualDevice.
														let response = ok(auth.request_id).encode_to_vec();
														let nonce = SalsaBox::generate_nonce(&mut OsRng);
														match boxed.encrypt(&nonce, response.as_slice()) {
															Ok(ciphertext) => {
																let mut frame = Vec::with_capacity(24 + ciphertext.len());
																frame.extend_from_slice(nonce.as_slice());
																frame.extend_from_slice(&ciphertext);
																let frame_len = frame.len();
																let frame_prefix = frame.iter().take(24).map(|b| format!("{b:02x}")).collect::<Vec<_>>().join(" ");

																ws_tx.send(WsMessage::Binary(frame.into())).await?;
																log::info!(
																	"[VSD2] encrypted authentication OK queued to {peer}: request_id={} frame_len={} nonce_prefix={}",
																	auth.request_id,
																	frame_len,
																	frame_prefix
																);

																// Match the merged Codex VSD2 lifecycle:
																// Authenticate -> OK -> encrypted VirtualDeviceList.
																// Mobile then sends OpenVirtualDevice with the
																// authoritative keypad_config/layout_crop.
																send_virtual_device_list(&ws_tx, &boxed, &key_id).await?;

																log::info!("[VSD2] QR pairing stage complete: encrypted VirtualDeviceList sent to {peer}; awaiting Mobile OpenVirtualDevice");
															}
															Err(_) => log::error!("[VSD2] failed to encrypt authentication OK for {peer}"),
														}
														PENDING_PAIRINGS.write().await.remove(&key_id);
													} else {
														let response = error_response(auth.request_id, ErrorCode::AuthenticationRejected, "Desktop did not approve this Stream Deck Mobile pairing")
															.encode_to_vec();
														let nonce = SalsaBox::generate_nonce(&mut OsRng);
														if let Ok(ciphertext) = boxed.encrypt(&nonce, response.as_slice()) {
															let mut frame = Vec::with_capacity(24 + ciphertext.len());
															frame.extend_from_slice(nonce.as_slice());
															frame.extend_from_slice(&ciphertext);
															ws_tx.send(WsMessage::Binary(frame.into())).await?;
														}
														PENDING_PAIRINGS.write().await.remove(&key_id);
													}
												}
												Ok(ClientMessage {
													payload: Some(client_message::Payload::CancelAuthenticate(cancel)),
												}) => {
													log::info!("[VSD2] decrypted CancelAuthenticate from {peer}: request_id={}", cancel.request_id);

													let response = error_response(cancel.request_id, ErrorCode::Cancelled, "Authentication cancelled by client").encode_to_vec();

													let nonce = SalsaBox::generate_nonce(&mut OsRng);
													match boxed.encrypt(&nonce, response.as_slice()) {
														Ok(ciphertext) => {
															let mut frame = Vec::with_capacity(24 + ciphertext.len());
															frame.extend_from_slice(nonce.as_slice());
															frame.extend_from_slice(&ciphertext);
															ws_tx.send(WsMessage::Binary(frame.into())).await?;
															log::info!("[VSD2] encrypted Cancelled response sent to {peer}: request_id={}", cancel.request_id);
														}
														Err(error) => {
															log::error!("[VSD2] failed to encrypt Cancelled response for {peer}: {error:?}");
														}
													}
												}
												Ok(ClientMessage {
													payload: Some(client_message::Payload::OpenVirtualDevice(open)),
												}) => {
													let expected_id = client_fingerprint.as_ref().map(|fingerprint| mobile_device_id(fingerprint));

													if expected_id.as_deref() != Some(open.device_id.as_str()) {
														log::warn!(
															"[VSD2] rejecting encrypted OpenVirtualDevice from {peer}: requested device={} does not match Mobile identity",
															open.device_id
														);
														send_encrypted(
															&ws_tx,
															&boxed,
															error_response(open.request_id, ErrorCode::AuthenticationRejected, "Virtual device does not belong to this Mobile identity"),
														)
														.await?;
														continue;
													}

													let (rows, columns) = open
														.keypad_config
														.as_ref()
														.and_then(|config| config.layout_crop.as_ref())
														.map(|size| (size.height.clamp(1, 255) as u8, size.width.clamp(1, 255) as u8))
														.unwrap_or((DEFAULT_ROWS, DEFAULT_COLS));

													log::info!(
														"[VSD2] decrypted OpenVirtualDevice from {peer}: request_id={} device_id={} MOBILE_LAYOUT={}x{}",
														open.request_id,
														open.device_id,
														rows,
														columns
													);

													update_mobile_device_layout(&open.device_id, rows, columns).await?;
													persist_mobile_layout_current_v47(&open.device_id, rows, columns).await?;

													authenticated = true;
													device_id = Some(open.device_id.clone());
													remember_keypad_config(&open.device_id, open.keypad_config.as_ref()).await;
													let session = attach_mobile_session(&open.device_id, ws_tx.clone(), true).await;
													attached_session = Some((open.device_id.clone(), session));

													let response = ServerMessage {
														payload: Some(server_message::Payload::VirtualDeviceOpened(VirtualDeviceOpened {
															request_id: open.request_id,
															device: Some(VirtualDevice {
																id: open.device_id.clone(),

																name: {
																	let fingerprint = client_fingerprint.as_deref().unwrap_or_default();
																	load_mobile_state_current_v47()
																		.await
																		.ok()
																		.and_then(|state| state.devices.into_iter().find(|device| device.fingerprint == fingerprint).map(|device| device.name))
																		.unwrap_or_else(|| CURRENT_V47_MOBILE_DEVICE_NAME.to_owned())
																},
															}),
														})),
													};

													send_encrypted(&ws_tx, &boxed, response).await?;
													log::info!("[VSD2] encrypted VirtualDeviceOpened sent to {peer}: request_id={} device_id={}", open.request_id, open.device_id);

													if let Some(config) = open.keypad_config.as_ref() {
														send_context(&ws_tx, &boxed, config).await?;
														log::info!("[VSD2] encrypted Context sent to {peer}: layout={}x{}", rows, columns);
													}

													replay_cached_mobile_images(&open.device_id).await?;
													request_mobile_icon_refresh().await;

													log::info!("[VSD2] encrypted OpenVirtualDevice ready: {} (MOBILE_LAYOUT={}x{})", open.device_id, rows, columns);
												}
												Ok(ClientMessage {
													payload: Some(client_message::Payload::DeleteVirtualDevice(delete)),
												}) => {
													log::info!("[VSD2] decrypted DeleteVirtualDevice from {peer}: request_id={}", delete.request_id);

													if let Some(id) = device_id.as_ref() {
														if let Some((attached_id, session)) = attached_session.take() {
															if attached_id == *id {
																detach_mobile_session(&attached_id, session).await;
															}
														}
														deregister_open_deck_device(id).await;
													}

													send_encrypted(&ws_tx, &boxed, ok(delete.request_id)).await?;

													log::info!("[VSD2] encrypted DeleteVirtualDevice OK sent to {peer}");
													return Ok(());
												}
												Ok(ClientMessage {
													payload: Some(client_message::Payload::UpdateKeypadConfig(update)),
												}) => {
													log::info!(
														"[VSD2] decrypted UpdateKeypadConfig from {peer}: icon_size={:?} pressed_icon_size={:?} layout_crop={:?}",
														update.icon_size.as_ref().map(|s| (s.width, s.height)),
														update.pressed_icon_size.as_ref().map(|s| (s.width, s.height)),
														update.layout_crop.as_ref().map(|s| (s.width, s.height))
													);

													if let Some(id) = device_id.as_ref() {
														apply_keypad_update(id, &update).await;
														if let Some(size) = update.layout_crop.as_ref() {
															let rows = size.height.clamp(1, 255) as u8;
															let columns = size.width.clamp(1, 255) as u8;
															update_mobile_device_layout(id, rows, columns).await?;
															persist_mobile_layout_current_v47(id, rows, columns).await?;
														}
													}
												}
												Ok(ClientMessage {
													payload: Some(client_message::Payload::KeyPress(key)),
												}) => {
													let Some(id) = device_id.as_ref() else {
														log::warn!("[VSD2] ignoring encrypted KeyPress from {peer} before a virtual device was opened");
														continue;
													};

													let Some(device) = crate::shared::DEVICES.get(id) else {
														log::warn!("[VSD2] ignoring encrypted KeyPress from {peer} for unavailable device {id}");
														continue;
													};

													let key_count = u32::from(device.rows) * u32::from(device.columns);
													drop(device);

													if key.index >= key_count || key.index > u32::from(u8::MAX) {
														log::warn!("[VSD2] ignoring out-of-range encrypted KeyPress from {peer}: device={id} index={} key_count={key_count}", key.index);
														continue;
													}

													let event = crate::events::inbound::PayloadEvent {
														payload: crate::events::inbound::devices::PressPayload {
															device: id.clone(),
															position: key.index as u8,
														},
													};

													let result = if key.pressed {
														crate::events::inbound::devices::key_down(event).await
													} else {
														crate::events::inbound::devices::key_up(event).await
													};

													if let Err(error) = result {
														log::warn!("[VSD2] failed to dispatch encrypted KeyPress from {peer}: {error}");
													} else {
														log::debug!("[VSD2] dispatched encrypted KeyPress from {peer}: device={id} index={} pressed={}", key.index, key.pressed);
													}
												}
												Ok(other) => {
													log::debug!("[VSD2] decrypted VSD2 ClientMessage from {peer}: {:?}", other.payload);
												}
												Err(decode_error) => {
													log::warn!("[VSD2] decrypted auth payload is not protobuf from {peer}: {decode_error}");
													log::debug!("[VSD2] decrypted RAW {peer}: {}", plaintext.iter().map(|b| format!("{b:02x}")).collect::<Vec<_>>().join(" "));
												}
											}
										}
										Err(_) => {
											log::warn!("[VSD2] could not decrypt authentication frame from {peer} with server key");
										}
									}
								}
							}
						}
						continue;
					}
				};

				match client.payload {
					Some(client_message::Payload::Hello(hello)) => {
						let info = hello.client_information.as_ref();

						if let Some(info) = info {
							log::info!(
								"[VSD2] HelloFromClient from {peer}: name={:?}, ua={:?}, protocol={}, model={:?}, os={:?} {:?}",
								info.name,
								info.user_agent,
								info.protocol_version,
								info.device_model,
								info.os_name,
								info.os_version
							);
						}

						if hello.public_key.is_empty() {
							anyhow::bail!("Stream Deck Mobile sent an empty public key");
						}

						let key_id = client_key_id(&hello.public_key);
						let id = format!("sdm-{key_id}");
						device_id = Some(id);
						client_fingerprint = Some(key_id.clone());

						CLIENT_PUBLIC_KEYS.write().await.insert(key_id.clone(), hello.public_key.clone());
						mobile_debug_log(&format!(
							"HELLO_RX peer={} fingerprint={} name={:?} legacy={}",
							peer,
							key_id,
							info.map(|i| i.name.as_str()),
							legacy_connection
						));

						log::debug!("[VSD2] stored Mobile public key for persistent identity {} ({} bytes)", key_id, hello.public_key.len());

						log::info!("[VSD2] Mobile client verification code/device ID: {key_id}");

						let address = endpoint_addresses().into_iter().next().unwrap_or_else(|| "127.0.0.1".to_owned());

						let already_authenticated = AUTHENTICATED_CLIENTS.read().await.contains(&key_id);
						if already_authenticated {
							PENDING_PAIRINGS.write().await.remove(&key_id);
							log::info!("[VSD2] known trusted Mobile {} connected on discovery socket; advertising clientNeedsAuthentication=false", key_id);
						} else {
							let mobile_name = info.map(|i| i.name.as_str()).filter(|name| !name.is_empty()).unwrap_or(CURRENT_V47_MOBILE_DEVICE_NAME);
							PENDING_PAIRINGS.write().await.insert(
								key_id.clone(),
								PendingPairing {
									fingerprint: key_id.clone(),
									name: mobile_name.to_owned(),
									peer: peer.to_string(),
									approved: false,
								},
							);
							log::info!("[VSD2] pending Mobile pairing candidate from Hello: fingerprint={} name={:?} peer={}", key_id, mobile_name, peer);
							mobile_debug_log(&format!("PENDING_FROM_HELLO fingerprint={} name={:?} peer={}", key_id, mobile_name, peer));
						}

						// HelloFromServer is the per-connection capability/trust
						// state. A Mobile client that has already been approved
						// must not be forced through Authenticate again simply
						// because it opened a fresh discovery socket.
						log::debug!(
							"[VSD2] HELLO_WORKSTATION peer={} workstation_id={} hostname={} mdns_id={}",
							peer,
							workstation_code(),
							hostname_string(),
							discovery_service_id()
						);

						let server_hello = HelloFromServer {
							workstation_id: workstation_code(),
							hostname: hostname_string(),
							version: env!("CARGO_PKG_VERSION").to_owned(),
							protocol_version: 2,
							public_key: server_key().to_vec(),
							client_needs_authentication: !already_authenticated,
							os_name: Some(std::env::consts::OS.to_owned()),
							os_version: None,
							endpoints: Some(ServiceEndpoints {
								addresses: vec![address.clone()],
								// Direct VSD2 endpoint used by the Mobile computer list.
								port: PORT as u32,
							}),
						};

						let response = ServerMessage {
							payload: Some(server_message::Payload::Hello(server_hello)),
						};

						let encoded = response.encode_to_vec();
						log::debug!("[VSD2] TX HelloFromServer to {peer}: {} bytes", encoded.len());

						ws_tx.send(WsMessage::Binary(encoded.into())).await?;
						mobile_debug_log(&format!(
							"HELLO_TX peer={} fingerprint={} client_needs_authentication={} endpoint={}:{}",
							peer, key_id, !already_authenticated, address, PORT
						));

						log::info!("[VSD2] HelloFromServer sent to {peer}; discovery socket ready");

						if already_authenticated {
							{
								let stored_key = CLIENT_PUBLIC_KEYS
									.read()
									.await
									.get(&key_id)
									.cloned()
									.ok_or_else(|| anyhow::anyhow!("No stored public key for trusted Mobile {key_id}"))?;
								let peer_key = PublicKey::from(<[u8; 32]>::try_from(stored_key.as_slice()).map_err(|_| anyhow::anyhow!("Stored Mobile public key has invalid length"))?);
								let cipher = SalsaBox::new(&peer_key, &server_secret_key());

								if legacy_connection {
									send_virtual_device_list_plain_current_v47(&ws_tx, &key_id).await?;
									log::info!("[VSD2] TRUSTED_CURRENT_V47_LIST_SENT fingerprint={} mode=legacy", key_id);
								}

								send_virtual_device_list(&ws_tx, &cipher, &key_id).await?;
								mobile_debug_log(&format!("TRUSTED_VDL_TX peer={} fingerprint={} mode=encrypted", peer, key_id));
								log::info!("[VSD2] TRUSTED_CURRENT_V47_LIST_SENT fingerprint={} mode=encrypted; awaiting Mobile OpenVirtualDevice", key_id);
							}
						} else {
							// The VSD2 client is expected to issue Authenticate after it
							// receives HelloFromServer(clientNeedsAuthentication=true).
							// Sending an empty list here is deliberately harmless (there
							// are no resources to expose before authentication), but gives
							// the Mobile state machine a complete discovery response.
							let empty_list = ServerMessage {
								payload: Some(server_message::Payload::VirtualDeviceList(VirtualDeviceList { devices: Vec::new() })),
							};
							ws_tx.send(WsMessage::Binary(empty_list.encode_to_vec().into())).await?;
							mobile_debug_log(&format!("UNTRUSTED_VDL_TX peer={} fingerprint={} devices=0 awaiting Authenticate", peer, key_id));
							log::info!("[VSD2] untrusted Mobile {} received empty VirtualDeviceList; awaiting Authenticate", key_id);
						}
					}

					Some(client_message::Payload::Authenticate(auth)) => {
						let key_id = client_fingerprint.clone().ok_or_else(|| anyhow::anyhow!("Authenticate received before Hello"))?;
						mobile_debug_log(&format!("AUTH_RX_PLAINTEXT peer={} fingerprint={} request_id={}", peer, key_id, auth.request_id));
						log::info!("[VSD2] Authenticate received from {peer}: fingerprint={} request_id={}", key_id, auth.request_id);

						// THIS is the exact point where desktop pairing becomes
						// relevant. Discovery/Hello never creates a prompt.
						{
							let mut pending = PENDING_PAIRINGS.write().await;
							let entry = pending.entry(key_id.clone()).or_insert_with(|| PendingPairing {
								fingerprint: key_id.clone(),
								name: CURRENT_V47_MOBILE_DEVICE_NAME.to_owned(),
								peer: peer.to_string(),
								approved: false,
							});
							entry.peer = peer.to_string();
						}

						log::info!("[VSD2] Authenticate received from {peer}: request_id={} verification_code={}", auth.request_id, key_id);
		let approval_state = PENDING_PAIRINGS.read().await.get(&key_id).map(|p| p.approved).unwrap_or(false);
		mobile_debug_log(&format!("AUTH_RX_APPROVAL_STATE fingerprint={} approved={}", key_id, approval_state));

						let approved = tokio::time::timeout(Duration::from_secs(60), async {
							loop {
								match PENDING_PAIRINGS.read().await.get(&key_id).cloned() {
									Some(pairing) if pairing.approved => break true,
									Some(_) => {}
									None => break false,
								}
								tokio::time::sleep(Duration::from_millis(100)).await;
							}
						})
						.await
						.unwrap_or(false);

						if !approved {
							let response = error_response(auth.request_id, ErrorCode::AuthenticationRejected, "Desktop did not approve this Stream Deck Mobile pairing");
							ws_tx.send(WsMessage::Binary(response.encode_to_vec().into())).await?;
							PENDING_PAIRINGS.write().await.remove(&key_id);
							log::info!("[VSD2] authentication rejected/timed out for {peer}: {key_id}");
							continue;
						}

						authenticated = true;
						AUTHENTICATED_CLIENTS.write().await.insert(key_id.clone());

						let public_key = CLIENT_PUBLIC_KEYS
							.read()
							.await
							.get(&key_id)
							.cloned()
							.ok_or_else(|| anyhow::anyhow!("No public key for approved Mobile {key_id}"))?;
						persist_mobile_approval_current_v47(&key_id, &public_key, DEFAULT_ROWS, DEFAULT_COLS).await?;

						ws_tx.send(WsMessage::Binary(ok(auth.request_id).encode_to_vec().into())).await?;

						let peer_key = PublicKey::from(<[u8; 32]>::try_from(public_key.as_slice()).map_err(|_| anyhow::anyhow!("Invalid Mobile public key"))?);
						let cipher = SalsaBox::new(&peer_key, &server_secret_key());
						send_virtual_device_list(&ws_tx, &cipher, &key_id).await?;

						PENDING_PAIRINGS.write().await.remove(&key_id);
						log::info!(
							"[VSD2] Authenticate accepted from {peer}: request_id={} trust persisted; encrypted VirtualDeviceList sent; awaiting OpenVirtualDevice",
							auth.request_id
						);
					}

					Some(client_message::Payload::CancelAuthenticate(cancel)) => {
						log::info!("[VSD2] CancelAuthenticate from {peer}: request_id={}", cancel.request_id);

						if let Some(key_id) = client_fingerprint.as_deref() {
							PENDING_PAIRINGS.write().await.remove(key_id);
						}

						let response = error_response(cancel.request_id, ErrorCode::Cancelled, "Authentication cancelled by client");

						ws_tx.send(WsMessage::Binary(response.encode_to_vec().into())).await?;
					}

					Some(client_message::Payload::ClientCapabilities(cap)) => {
						log::info!("[VSD2] ClientCapabilities from {peer}: is_user_pro={}", cap.is_user_pro);
					}

					Some(client_message::Payload::CreateVirtualDevice(create)) => {
						let id = device_id.clone().unwrap_or_else(|| format!("sdm-{}", peer.ip()));

						let keypad = create.keypad_config.clone().unwrap_or_else(|| KeypadConfig {
							supported_icon_image_formats: vec![ImageFormat::Png as i32],
							icon_size: Some(Size { width: 96, height: 96 }),
							pressed_icon_size: Some(Size { width: 96, height: 96 }),
							high_dpi: true,
							overscale: true,
							layout_crop: Some(Size {
								width: DEFAULT_COLS as u32,
								height: DEFAULT_ROWS as u32,
							}),
							enable_context_api: true,
						});

						let (rows, columns) = keypad
							.layout_crop
							.as_ref()
							.map(|size| (size.height.clamp(1, 255) as u8, size.width.clamp(1, 255) as u8))
							.unwrap_or((DEFAULT_ROWS, DEFAULT_COLS));

						log::info!(
							"[VSD2] CreateVirtualDevice from {peer}: request_id={} name={:?} layout={}x{} auth={} device={}",
							create.request_id,
							create.name,
							rows,
							columns,
							authenticated,
							id
						);

						register_open_deck_device(&id, &create.name, (rows, columns)).await?;
						remember_keypad_config(&id, Some(&keypad)).await;
						let session = attach_mobile_session(&id, ws_tx.clone(), false).await;
						attached_session = Some((id.clone(), session));

						let response = ServerMessage {
							payload: Some(server_message::Payload::VirtualDeviceOpened(VirtualDeviceOpened {
								request_id: create.request_id,
								device: Some(VirtualDevice {
									id: id.clone(),
									name: create.name.clone(),
								}),
							})),
						};

						ws_tx.send(WsMessage::Binary(response.encode_to_vec().into())).await?;

						send_context_plain(&ws_tx, &keypad).await?;

						log::info!("[VSD2] virtual device ready: {} ({}x{})", id, rows, columns);
					}

					Some(client_message::Payload::OpenVirtualDevice(open)) => {
						let (rows, columns) = open
							.keypad_config
							.as_ref()
							.and_then(|cfg| cfg.layout_crop.as_ref())
							.map(|size| (size.height.clamp(1, 255) as u8, size.width.clamp(1, 255) as u8))
							.unwrap_or((DEFAULT_ROWS, DEFAULT_COLS));

						log::info!(
							"[VSD2] OpenVirtualDevice from {peer}: request_id={} device_id={} MOBILE_LAYOUT={}x{}",
							open.request_id,
							open.device_id,
							rows,
							columns
						);

						// Mobile owns the physical keypad geometry.
						update_mobile_device_layout(&open.device_id, rows, columns).await?;

						if !crate::shared::DEVICES.contains_key(&open.device_id) {
							log::error!("[VSD2] OpenVirtualDevice register failed: id={} is not present in OpenDeck DEVICES", open.device_id);

							let response = error_response(open.request_id, ErrorCode::DeviceNotFound, "Failed to register Stream Deck Mobile in OpenDeck");

							ws_tx.send(WsMessage::Binary(response.encode_to_vec().into())).await?;
							continue;
						}

						authenticated = true;
						device_id = Some(open.device_id.clone());
						remember_keypad_config(&open.device_id, open.keypad_config.as_ref()).await;
						let session = attach_mobile_session(&open.device_id, ws_tx.clone(), false).await;
						attached_session = Some((open.device_id.clone(), session));

						log::info!("[VSD2] OpenVirtualDevice attached to OpenDeck device {} (MOBILE_LAYOUT={}x{})", open.device_id, rows, columns);

						let response = ServerMessage {
							payload: Some(server_message::Payload::VirtualDeviceOpened(VirtualDeviceOpened {
								request_id: open.request_id,
								device: Some(VirtualDevice {
									id: open.device_id.clone(),
									name: CURRENT_V47_MOBILE_DEVICE_NAME.to_owned(),
								}),
							})),
						};

						ws_tx.send(WsMessage::Binary(response.encode_to_vec().into())).await?;

						if let Some(cfg) = open.keypad_config.as_ref() {
							send_context_plain(&ws_tx, cfg).await?;
						}

						replay_cached_mobile_images(&open.device_id).await?;
						request_mobile_icon_refresh().await;
					}

					Some(client_message::Payload::DeleteVirtualDevice(delete)) => {
						log::info!("[VSD2] DeleteVirtualDevice from {peer}: request_id={}", delete.request_id);

						if let Some(id) = device_id.as_ref() {
							if let Some((attached_id, session)) = attached_session.take() {
								if attached_id == *id {
									detach_mobile_session(&attached_id, session).await;
								}
							}
							deregister_open_deck_device(id).await;
						}

						let response = ok(delete.request_id);
						ws_tx.send(WsMessage::Binary(response.encode_to_vec().into())).await?;
					}

					Some(client_message::Payload::UpdateKeypadConfig(update)) => {
						log::info!(
							"[VSD2] UpdateKeypadConfig from {peer}: icon_size={:?} pressed_icon_size={:?} layout_crop={:?}",
							update.icon_size.as_ref().map(|s| (s.width, s.height)),
							update.pressed_icon_size.as_ref().map(|s| (s.width, s.height)),
							update.layout_crop.as_ref().map(|s| (s.width, s.height))
						);

						if let Some(id) = device_id.as_ref() {
							apply_keypad_update(id, &update).await;
							if let Some(size) = update.layout_crop.as_ref() {
								let rows = size.height.clamp(1, 255) as u8;
								let columns = size.width.clamp(1, 255) as u8;
								update_mobile_device_layout(id, rows, columns).await?;
							}
						}
					}

					Some(client_message::Payload::KeyPress(key)) => {
						if let Some(id) = device_id.as_ref() {
							log::info!("[VSD2] KeyPress from {peer}: device={} index={} pressed={}", id, key.index, key.pressed);
							dispatch_mobile_keypress(id, key.index, key.pressed).await;
						}
					}

					Some(client_message::Payload::NextPage(_)) => {
						log::info!("[VSD2] NextPage from {peer}");
					}
					Some(client_message::Payload::PreviousPage(_)) => {
						log::info!("[VSD2] PreviousPage from {peer}");
					}
					Some(client_message::Payload::PageByIndex(page)) => {
						log::info!("[VSD2] PageByIndex from {peer}: index={}", page.index);
					}
					Some(client_message::Payload::AssignShortcut(assign)) => {
						log::info!(
							"[VSD2] AssignShortcut from {peer}: profile={:?} shortcut={:?} index={}",
							assign.profile_id,
							assign.shortcut_id,
							assign.index
						);
					}
					Some(client_message::Payload::RemoveShortcut(remove)) => {
						log::info!("[VSD2] RemoveShortcut from {peer}: request_id={} shortcut={:?}", remove.request_id, remove.shortcut_id);
					}
					Some(client_message::Payload::TriggerShortcut(trigger)) => {
						log::info!("[VSD2] TriggerShortcut from {peer}: device_id={:?} shortcut={:?}", trigger.device_id, trigger.shortcut_id);
					}
					None => log::warn!("[VSD2] empty ClientMessage from {peer}"),
				}
			}

			WsMessage::Ping(payload) => {
				ws_tx.send(WsMessage::Pong(payload)).await?;
			}

			WsMessage::Close(frame) => {
				log::info!("[VSD2] RX close from {peer}: {:?}", frame);
				break;
			}

			WsMessage::Pong(_) | WsMessage::Text(_) | WsMessage::Frame(_) => {}
		}
	}

	if let Some(key_id) = client_fingerprint.as_ref() {
		// Stream Deck Mobile uses multiple short-lived WebSockets. The
		// encrypted authentication frame may arrive on a later socket, so
		// keep the public key by persistent Mobile fingerprint.
		log::debug!("[VSD2] preserving Mobile public-key identity {} after socket disconnect", key_id);
	}

	if let Some((id, session)) = attached_session.take() {
		detach_mobile_session(&id, session).await;
		log::info!("[VSD2] active Mobile session closed for {peer}; device remains registered");
	}

	drop(ws_tx);
	heartbeat.abort();
	let _ = heartbeat.await;
	let _ = writer.await;

	mobile_debug_log(&format!(
		"WS_END peer={} fingerprint={} device_id={:?} authenticated={} attached={}",
		peer,
		client_fingerprint.as_deref().unwrap_or(""),
		device_id,
		authenticated,
		attached_session.is_some()
	));
	log::info!("[VSD2] WebSocket client {peer} disconnected");
	Ok(())
}

fn ok(request_id: u32) -> ServerMessage {
	ServerMessage {
		payload: Some(server_message::Payload::Ok(Ok { request_id })),
	}
}

fn error_response(request_id: u32, code: ErrorCode, reason: &str) -> ServerMessage {
	ServerMessage {
		payload: Some(server_message::Payload::Error(Error {
			request_id,
			code: code as i32,
			reason: Some(reason.to_owned()),
		})),
	}
}

fn mobile_device_id(fingerprint: &str) -> String {
	format!("sdm-{fingerprint}")
}

async fn ensure_mobile_device(fingerprint: &str, name: &str, rows: u8, columns: u8) -> anyhow::Result<String> {
	let id = mobile_device_id(fingerprint);
	if !crate::shared::DEVICES.contains_key(&id) {
		register_open_deck_device(&id, name, (rows, columns)).await?;
	}

	if !crate::shared::DEVICES.contains_key(&id) {
		return Err(anyhow::anyhow!("OpenDeck device registry did not contain {} after register_device()", id));
	}

	log::info!("[VSD2] OpenDeck virtual device registered: id={} name={:?} layout={}x{}", id, name, rows, columns);

	Ok(id)
}

async fn send_encrypted(tx: &mpsc::Sender<WsMessage>, cipher: &SalsaBox, message: ServerMessage) -> anyhow::Result<()> {
	let nonce = SalsaBox::generate_nonce(&mut OsRng);
	let plaintext = message.encode_to_vec();
	let ciphertext = cipher
		.encrypt(&nonce, plaintext.as_slice())
		.map_err(|error| anyhow::anyhow!("failed to encrypt VSD2 response: {error:?}"))?;
	let mut frame = Vec::with_capacity(nonce.len() + ciphertext.len());
	frame.extend_from_slice(nonce.as_slice());
	frame.extend_from_slice(&ciphertext);
	tx.send(WsMessage::Binary(frame.into())).await?;
	Ok(())
}

async fn send_virtual_device_list_plain_current_v47(tx: &mpsc::Sender<WsMessage>, fingerprint: &str) -> anyhow::Result<()> {
	let id = mobile_device_id(fingerprint);
	let state = load_mobile_state_current_v47().await?;
	let name = state
		.devices
		.iter()
		.find(|device| device.fingerprint == fingerprint)
		.map(|device| device.name.clone())
		.unwrap_or_else(|| CURRENT_V47_MOBILE_DEVICE_NAME.to_owned());

	let devices = if crate::shared::DEVICES.contains_key(&id) { vec![VirtualDevice { id, name }] } else { Vec::new() };

	let message = ServerMessage {
		payload: Some(server_message::Payload::VirtualDeviceList(VirtualDeviceList { devices })),
	};

	tx.send(WsMessage::Binary(message.encode_to_vec().into())).await?;
	Ok(())
}

async fn send_virtual_device_list(tx: &mpsc::Sender<WsMessage>, cipher: &SalsaBox, fingerprint: &str) -> anyhow::Result<()> {
	let id = mobile_device_id(fingerprint);
	let state = load_mobile_state_current_v47().await?;
	let name = state
		.devices
		.iter()
		.find(|device| device.fingerprint == fingerprint)
		.map(|device| device.name.clone())
		.unwrap_or_else(|| CURRENT_V47_MOBILE_DEVICE_NAME.to_owned());

	let devices = if state.devices.iter().any(|device| device.fingerprint == fingerprint) {
		vec![VirtualDevice { id: id.clone(), name }]
	} else {
		Vec::new()
	};

	let count = devices.len();
	let message = ServerMessage {
		payload: Some(server_message::Payload::VirtualDeviceList(VirtualDeviceList { devices })),
	};

	send_encrypted(tx, cipher, message).await?;

	log::info!("[VSD2] encrypted VirtualDeviceList sent to Mobile {}: devices={}", fingerprint, count);

	Ok(())
}

async fn update_mobile_device_layout(device_id: &str, rows: u8, columns: u8) -> anyhow::Result<()> {
	let Some(current) = crate::shared::DEVICES.get(device_id) else {
		return register_open_deck_device(device_id, CURRENT_V47_MOBILE_DEVICE_NAME, (rows, columns)).await;
	};

	if current.rows == rows && current.columns == columns {
		return Ok(());
	}

	let name = current.name.clone();
	drop(current);

	log::info!("[VSD2] Mobile keypad layout is authoritative: {} -> {}x{}", device_id, rows, columns);

	deregister_open_deck_device(device_id).await;

	register_open_deck_device(device_id, &name, (rows, columns)).await
}

async fn register_open_deck_device(device_id: &str, name: &str, (rows, columns): (u8, u8)) -> anyhow::Result<()> {
	if crate::shared::DEVICES.contains_key(device_id) {
		return Ok(());
	}
	crate::events::inbound::devices::register_device(
		"",
		crate::events::inbound::PayloadEvent {
			payload: crate::shared::DeviceInfo {
				id: device_id.to_owned(),
				plugin: String::new(),
				name: name.to_owned(),
				rows,
				columns,
				encoders: 0,
				touchpoints: 0,
				infobars: 0,
				r#type: 3,
			},
		},
	)
	.await?;
	Ok(())
}

async fn deregister_open_deck_device(device_id: &str) {
	let _ = crate::events::inbound::devices::deregister_device("", crate::events::inbound::PayloadEvent { payload: device_id.to_owned() }).await;
}

async fn send_context_plain(tx: &mpsc::Sender<WsMessage>, keypad: &KeypadConfig) -> anyhow::Result<()> {
	let rows = keypad.layout_crop.as_ref().map(|size| size.height).unwrap_or(DEFAULT_ROWS as u32);
	let columns = keypad.layout_crop.as_ref().map(|size| size.width).unwrap_or(DEFAULT_COLS as u32);

	let message = ServerMessage {
		payload: Some(server_message::Payload::Context(Context {
			profile_id: "opendeck-mobile-profile".to_owned(),
			total_pages: 1,
			current_page: 0,
			actions: (0..rows.saturating_mul(columns))
				.map(|index| Action {
					index,
					title: String::new(),
					name: String::new(),
					category: String::new(),
					shortcut_id: None,
				})
				.collect(),
		})),
	};
	tx.send(WsMessage::Binary(message.encode_to_vec().into())).await?;
	Ok(())
}

async fn send_context(tx: &mpsc::Sender<WsMessage>, cipher: &SalsaBox, keypad: &KeypadConfig) -> anyhow::Result<()> {
	let (rows, columns) = keypad
		.layout_crop
		.as_ref()
		.map(|size| (size.height.clamp(1, 255) as u8, size.width.clamp(1, 255) as u8))
		.unwrap_or((DEFAULT_ROWS, DEFAULT_COLS));

	let actions = (0..(rows as u32 * columns as u32))
		.map(|index| Action {
			index,
			title: String::new(),
			name: String::new(),
			category: String::new(),
			shortcut_id: None,
		})
		.collect();

	let message = ServerMessage {
		payload: Some(server_message::Payload::Context(Context {
			profile_id: "opendeck-mobile-profile".to_owned(),
			total_pages: 1,
			current_page: 0,
			actions,
		})),
	};

	send_encrypted(tx, cipher, message).await?;
	Ok(())
}

async fn remember_keypad_config(device_id: &str, config: Option<&KeypadConfig>) {
	if let Some(config) = config {
		KEYPAD_CONFIGS.write().await.insert(device_id.to_owned(), config.clone());
		log::info!(
			"[VSD2] keypad config for {}: icon_size={:?} formats={:?} high_dpi={}",
			device_id,
			config.icon_size.as_ref().map(|size| (size.width, size.height)),
			config.supported_icon_image_formats,
			config.high_dpi
		);
	}
}

async fn apply_keypad_update(device_id: &str, update: &UpdateKeypadConfig) {
	let mut configs = KEYPAD_CONFIGS.write().await;
	let config = configs.entry(device_id.to_owned()).or_insert_with(|| KeypadConfig {
		supported_icon_image_formats: vec![ImageFormat::Jpg as i32, ImageFormat::Png as i32],
		icon_size: Some(Size { width: 144, height: 144 }),
		pressed_icon_size: None,
		high_dpi: true,
		overscale: true,
		layout_crop: None,
		enable_context_api: true,
	});
	if update.icon_size.is_some() {
		config.icon_size = update.icon_size.clone();
	}
	if update.pressed_icon_size.is_some() {
		config.pressed_icon_size = update.pressed_icon_size.clone();
	}
	if let Some(high_dpi) = update.high_dpi {
		config.high_dpi = high_dpi;
	}
	if update.layout_crop.is_some() {
		config.layout_crop = update.layout_crop.clone();
	}
}

async fn request_mobile_icon_refresh() {
	if let Some(app) = crate::APP_HANDLE.get() {
		if let Err(error) = crate::events::frontend::profiles::rerender_images(app).await {
			log::debug!("[VSD2] could not request frontend icon refresh: {error}");
		}
	}
}

async fn dispatch_mobile_keypress(device_id: &str, index: u32, pressed: bool) {
	let Some(device) = crate::shared::DEVICES.get(device_id) else {
		log::warn!("[VSD2] ignoring KeyPress for unavailable device {device_id}");
		return;
	};
	let key_count = u32::from(device.rows) * u32::from(device.columns);
	drop(device);

	if index >= key_count || index > u32::from(u8::MAX) {
		log::warn!("[VSD2] ignoring out-of-range KeyPress device={device_id} index={index} key_count={key_count}");
		return;
	}

	let event = crate::events::inbound::PayloadEvent {
		payload: crate::events::inbound::devices::PressPayload {
			device: device_id.to_owned(),
			position: index as u8,
		},
	};
	let result = if pressed {
		crate::events::inbound::devices::key_down(event).await
	} else {
		crate::events::inbound::devices::key_up(event).await
	};
	if let Err(error) = result {
		log::warn!("[VSD2] failed to dispatch KeyPress device={device_id}: {error}");
	}
}

/// Push an OpenDeck image to a connected Mobile client. Returns true when handled.
async fn mobile_session_cipher(device_id: &str) -> anyhow::Result<SalsaBox> {
	let fingerprint = device_id.strip_prefix("sdm-").ok_or_else(|| anyhow::anyhow!("invalid Mobile device id: {device_id}"))?;

	let public_key = CLIENT_PUBLIC_KEYS
		.read()
		.await
		.get(fingerprint)
		.cloned()
		.ok_or_else(|| anyhow::anyhow!("no Mobile public key for {fingerprint}"))?;

	let peer_key = PublicKey::from(<[u8; 32]>::try_from(public_key.as_slice()).map_err(|_| anyhow::anyhow!("invalid Mobile public key"))?);

	Ok(SalsaBox::new(&peer_key, &server_secret_key()))
}

async fn replay_cached_mobile_images(device_id: &str) -> anyhow::Result<()> {
	let cached = MOBILE_IMAGE_CACHE.read().await.get(device_id).cloned();
	let Some(cached) = cached else {
		return Ok(());
	};

	let count = cached.len();
	for (position, data_url) in cached {
		update_image(device_id, position, data_url.as_deref()).await?;
	}
	log::info!("[VSD2] replayed {} cached Mobile icons after session attach: device={}", count, device_id);
	Ok(())
}

pub async fn update_image(device_id: &str, position: u8, data_url: Option<&str>) -> anyhow::Result<bool> {
	if !is_mobile_device(device_id) {
		return Ok(false);
	}
	MOBILE_IMAGE_CACHE
		.write()
		.await
		.entry(device_id.to_owned())
		.or_default()
		.insert(position, data_url.map(|value| value.to_owned()));
	let client = CLIENTS.read().await.get(device_id).cloned();
	let Some(client) = client else {
		log::debug!("[VSD2] cached Mobile icon device={} index={} (no icon session yet)", device_id, position);
		return Ok(true);
	};

	let keypad = KEYPAD_CONFIGS.read().await.get(device_id).cloned();
	let image = encode_mobile_icon(data_url, keypad.as_ref())?;
	send_icon_message(device_id, &client, position as u32, image).await?;
	log::info!("[VSD2] Icon sent to Mobile: device={} index={} encrypt={} bytes queued", device_id, position, client.encrypt);

	Ok(true)
}

async fn send_icon_message(device_id: &str, client: &ClientHandle, index: u32, image: Image) -> anyhow::Result<()> {
	let message = ServerMessage {
		payload: Some(server_message::Payload::Icon(Icon { index, image: Some(image) })),
	};
	if client.encrypt {
		let cipher = mobile_session_cipher(device_id).await?;
		send_encrypted(&client.tx, &cipher, message).await?;
	} else {
		client.tx.send(WsMessage::Binary(message.encode_to_vec().into())).await?;
	}
	Ok(())
}

fn preferred_mobile_image_format(keypad: Option<&KeypadConfig>) -> ImageFormat {
	let supported = keypad.map(|config| config.supported_icon_image_formats.as_slice()).unwrap_or(&[]);
	if supported.is_empty() {
		return ImageFormat::Lz4;
	}
	for format in [ImageFormat::Lz4, ImageFormat::Lzf, ImageFormat::Lzfse, ImageFormat::Png, ImageFormat::Jpg] {
		if supported.contains(&(format as i32)) {
			return format;
		}
	}
	ImageFormat::Png
}

fn encode_mobile_icon(data_url: Option<&str>, keypad: Option<&KeypadConfig>) -> anyhow::Result<Image> {
	let target = keypad
		.and_then(|config| config.icon_size.as_ref())
		.map(|size| (size.width.max(1), size.height.max(1)))
		.unwrap_or((144, 144));
	let format = preferred_mobile_image_format(keypad);
	let Some(data_url) = data_url else {
		return empty_icon_for_format(target, format);
	};
	let Some((_, encoded)) = data_url.split_once(',') else {
		return empty_icon_for_format(target, format);
	};
	let bytes = base64::engine::general_purpose::STANDARD.decode(encoded)?;
	let img = image::load_from_memory(&bytes)?;
	let resized = img.resize_exact(target.0, target.1, image::imageops::FilterType::Lanczos3);
	let (width, height) = resized.dimensions();
	match format {
		ImageFormat::Lz4 | ImageFormat::Lzf | ImageFormat::Lzfse => {
			let mut rgba = resized.to_rgba8();
			// Stream Deck Mobile expects BGRA byte order for the raw LZ4 payload.
			for pixel in rgba.as_mut() {
				// no-op here; channel swap is performed per 4-byte pixel below
			}
			let raw = rgba.as_mut();
			for px in raw.chunks_exact_mut(4) {
				px.swap(0, 2);
			}
			mobile_debug_log(&format!("IMAGE_ENCODE format=LZ4 size={}x{} bytes={} channels=R<->B-swapped", width, height, raw.len()));
			Ok(Image {
				format: ImageFormat::Lz4 as i32,
				r#type: ImageType::Transparent as i32,
				size: Some(Size { width, height }),
				row_bytes: width * 4,
				image: lz4_flex::block::compress(raw),
			})
		}
		ImageFormat::Jpg => {
			let rgb = resized.to_rgb8();
			let mut out = Vec::new();
			image::codecs::jpeg::JpegEncoder::new_with_quality(&mut out, 90).write_image(&rgb, width, height, image::ExtendedColorType::Rgb8)?;
			Ok(Image {
				format: ImageFormat::Jpg as i32,
				r#type: ImageType::Opaque as i32,
				size: Some(Size { width, height }),
				row_bytes: width * 3,
				image: out,
			})
		}
		ImageFormat::Png => {
			let rgba = resized.to_rgba8();
			let mut out = Vec::new();
			image::codecs::png::PngEncoder::new(&mut out).write_image(&rgba, width, height, image::ExtendedColorType::Rgba8)?;
			Ok(Image {
				format: ImageFormat::Png as i32,
				r#type: ImageType::Transparent as i32,
				size: Some(Size { width, height }),
				row_bytes: width * 4,
				image: out,
			})
		}
		_ => anyhow::bail!("unsupported Mobile image format {:?}", format),
	}
}

pub async fn clear_screen(device_id: &str) -> bool {
	if !is_mobile_device(device_id) {
		return false;
	}
	let client = CLIENTS.read().await.get(device_id).cloned();
	let Some(client) = client else {
		return true;
	};

	let keypad = KEYPAD_CONFIGS.read().await.get(device_id).cloned();
	let blank = encode_mobile_icon(None, keypad.as_ref()).ok();
	let count = crate::shared::DEVICES
		.get(device_id)
		.map(|device| device.rows as u32 * device.columns as u32)
		.unwrap_or(DEFAULT_ROWS as u32 * DEFAULT_COLS as u32);

	for index in 0..count {
		if let Some(image) = blank.clone() {
			let _ = send_icon_message(device_id, &client, index, image).await;
		}
	}
	true
}

fn empty_icon_for_format(target: (u32, u32), format: ImageFormat) -> anyhow::Result<Image> {
	match format {
		ImageFormat::Lz4 | ImageFormat::Lzf | ImageFormat::Lzfse => {
			let raw = vec![0u8; target.0 as usize * target.1 as usize * 4];
			Ok(Image {
				format: ImageFormat::Lz4 as i32,
				r#type: ImageType::Transparent as i32,
				size: Some(Size { width: target.0, height: target.1 }),
				row_bytes: target.0 * 4,
				image: lz4_flex::block::compress(&raw),
			})
		}
		ImageFormat::Jpg => {
			let rgb = image::RgbImage::from_pixel(target.0.max(2), target.1.max(2), image::Rgb([0, 0, 0]));
			let (width, height) = rgb.dimensions();
			let mut out = Vec::new();
			image::codecs::jpeg::JpegEncoder::new_with_quality(&mut out, 80).write_image(&rgb, width, height, image::ExtendedColorType::Rgb8)?;
			Ok(Image {
				format: ImageFormat::Jpg as i32,
				r#type: ImageType::Opaque as i32,
				size: Some(Size { width, height }),
				row_bytes: width * 3,
				image: out,
			})
		}
		ImageFormat::Png => {
			let rgba = image::RgbaImage::from_pixel(target.0.max(2), target.1.max(2), image::Rgba([0, 0, 0, 0]));
			let (width, height) = rgba.dimensions();
			let mut out = Vec::new();
			image::codecs::png::PngEncoder::new(&mut out).write_image(&rgba, width, height, image::ExtendedColorType::Rgba8)?;
			Ok(Image {
				format: ImageFormat::Png as i32,
				r#type: ImageType::Transparent as i32,
				size: Some(Size { width, height }),
				row_bytes: width * 4,
				image: out,
			})
		}
		_ => anyhow::bail!("unsupported Mobile image format {:?}", format),
	}
}

async fn run_mdns_announcer() {
	let Some(ip) = local_ipv4() else {
		log::warn!("Stream Deck Mobile mDNS advertisement disabled: no local IPv4 route found");
		return;
	};

	let hostname = hostname_string();
	let workstation = workstation_code();
	let discovery_id = discovery_service_id();
	let token = pairing_token();
	let txt = [
		format!("id={discovery_id}"),
		format!("name={hostname}"),
		format!("a={ip}:{LEGACY_PORT}"),
		format!("av2={ip}:{PORT}"),
		format!("t={token}"),
	];

	// Avahi already owns UDP/5353 on typical Linux desktops. Publishing
	// through it is what Stream Deck Mobile's network search actually sees.
	let avahi = tokio::process::Command::new("avahi-publish-service")
		.arg("--no-fail")
		.arg("-s")
		.arg(&hostname)
		.arg("_elg._tcp")
		.arg(LEGACY_PORT.to_string())
		.args(&txt)
		.kill_on_drop(true)
		.spawn();

	match avahi {
		Ok(mut child) => {
			mobile_debug_log(&format!(
				"MDNS_AVAHI_STARTED name={:?} type=_elg._tcp port={} id={} workstation_id={} ip={}:{} av2={}:{}",
				hostname, LEGACY_PORT, discovery_id, workstation, ip, LEGACY_PORT, ip, PORT
			));
			log::info!(
				"[VSD2] mDNS via avahi-publish-service: name={:?} type=_elg._tcp port={} id={} a={}:{} av2={}:{}",
				hostname,
				LEGACY_PORT,
				workstation,
				ip,
				LEGACY_PORT,
				ip,
				PORT
			);
			tokio::spawn(async move {
				let status = child.wait().await;
				mobile_debug_log(&format!("MDNS_AVAHI_EXITED status={:?}", status));
				log::warn!("[VSD2] avahi-publish-service exited: {:?}", status);
			});
		}
		Err(error) => {
			mobile_debug_log(&format!("MDNS_AVAHI_START_FAILED error={}", error));
			log::warn!("[VSD2] avahi-publish-service unavailable ({error}); using raw multicast announcements");
		}
	}

	let socket = match UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)) {
		Ok(socket) => socket,
		Err(error) => {
			log::warn!("Failed to bind mDNS advertiser: {error}");
			return;
		}
	};
	let _ = socket.set_multicast_ttl_v4(255);
	let _ = socket.set_multicast_loop_v4(true);
	mobile_debug_log(&format!("MDNS_RAW_SOCKET_READY ip={} multicast=224.0.0.251:5353", ip));

	let instance = hostname.clone();
	let host = format!("{}.local.", hostname.to_lowercase().replace(' ', "-"));
	let service = format!("{}.{}", instance, SERVICE_TYPE);

	log::info!(
		"[VSD2] mDNS advertising service: instance={} service={} host={} id={} port={}",
		instance,
		service,
		host,
		workstation,
		LEGACY_PORT
	);

	for legacy_instance in [
		format!("{}-{}", hostname, workstation),
		format!("OpenDeck {}", hostname),
		format!("OpenDeck-{}", hostname),
		"OpenDeck".to_owned(),
	] {
		if legacy_instance == instance {
			continue;
		}
		let legacy_service = format!("{}.{}", legacy_instance, SERVICE_TYPE);
		let goodbye = build_mdns_goodbye(&legacy_service, &host, ip, LEGACY_PORT);
		for _ in 0..3 {
			let _ = socket.send_to(&goodbye, (Ipv4Addr::new(224, 0, 0, 251), 5353));
		}
	}

	loop {
		let packet = build_mdns_response(&service, &host, &instance, ip, LEGACY_PORT);
		match socket.send_to(&packet, (Ipv4Addr::new(224, 0, 0, 251), 5353)) {
			Ok(bytes) => mobile_debug_log(&format!("MDNS_RAW_SENT bytes={} service={} ip={} port={}", bytes, service, ip, LEGACY_PORT)),
			Err(error) => mobile_debug_log(&format!("MDNS_RAW_SEND_FAILED error={} service={} ip={}", error, service, ip)),
		}
		tokio::time::sleep(Duration::from_secs(10)).await;
	}
}

fn dns_name(name: &str, out: &mut Vec<u8>) {
	for label in name.trim_end_matches('.').split('.') {
		out.push(label.len() as u8);
		out.extend_from_slice(label.as_bytes());
	}
	out.push(0);
}

fn build_mdns_goodbye(service: &str, host: &str, _ip: Ipv4Addr, port: u16) -> Vec<u8> {
	let mut out = Vec::with_capacity(512);
	out.extend_from_slice(&0u16.to_be_bytes());
	out.extend_from_slice(&0x8400u16.to_be_bytes());
	out.extend_from_slice(&0u16.to_be_bytes());
	out.extend_from_slice(&4u16.to_be_bytes());
	out.extend_from_slice(&0u16.to_be_bytes());
	out.extend_from_slice(&0u16.to_be_bytes());

	// PTR
	dns_name(SERVICE_TYPE, &mut out);
	out.extend_from_slice(&12u16.to_be_bytes());
	out.extend_from_slice(&1u16.to_be_bytes());
	out.extend_from_slice(&0u32.to_be_bytes());
	let mut ptr = Vec::new();
	dns_name(service, &mut ptr);
	out.extend_from_slice(&(ptr.len() as u16).to_be_bytes());
	out.extend_from_slice(&ptr);

	// SRV
	dns_name(service, &mut out);
	out.extend_from_slice(&33u16.to_be_bytes());
	out.extend_from_slice(&0x8001u16.to_be_bytes());
	out.extend_from_slice(&0u32.to_be_bytes());
	let mut srv = Vec::new();
	srv.extend_from_slice(&0u16.to_be_bytes());
	srv.extend_from_slice(&0u16.to_be_bytes());
	srv.extend_from_slice(&port.to_be_bytes());
	dns_name(host, &mut srv);
	out.extend_from_slice(&(srv.len() as u16).to_be_bytes());
	out.extend_from_slice(&srv);

	// TXT (empty goodbye record).
	dns_name(service, &mut out);
	out.extend_from_slice(&16u16.to_be_bytes());
	out.extend_from_slice(&0x8001u16.to_be_bytes());
	out.extend_from_slice(&0u32.to_be_bytes());
	out.extend_from_slice(&1u16.to_be_bytes());
	out.push(0);

	// A goodbye.
	dns_name(host, &mut out);
	out.extend_from_slice(&1u16.to_be_bytes());
	out.extend_from_slice(&0x8001u16.to_be_bytes());
	out.extend_from_slice(&0u32.to_be_bytes());
	out.extend_from_slice(&4u16.to_be_bytes());
	out.extend_from_slice(&[0, 0, 0, 0]);

	out
}

fn build_mdns_response(service: &str, host: &str, instance: &str, ip: Ipv4Addr, port: u16) -> Vec<u8> {
	let mut out = Vec::with_capacity(512);
	out.extend_from_slice(&0u16.to_be_bytes());
	out.extend_from_slice(&0x8400u16.to_be_bytes());
	out.extend_from_slice(&0u16.to_be_bytes());
	out.extend_from_slice(&4u16.to_be_bytes());
	out.extend_from_slice(&0u16.to_be_bytes());
	out.extend_from_slice(&0u16.to_be_bytes());

	// PTR: _elg._tcp.local -> <instance>._elg._tcp.local
	dns_name(SERVICE_TYPE, &mut out);
	out.extend_from_slice(&12u16.to_be_bytes());
	out.extend_from_slice(&1u16.to_be_bytes());
	out.extend_from_slice(&30u32.to_be_bytes());
	let mut ptr = Vec::new();
	dns_name(service, &mut ptr);
	out.extend_from_slice(&(ptr.len() as u16).to_be_bytes());
	out.extend_from_slice(&ptr);

	// SRV: <instance>._elg._tcp.local -> host:28198
	dns_name(service, &mut out);
	out.extend_from_slice(&33u16.to_be_bytes());
	out.extend_from_slice(&0x8001u16.to_be_bytes());
	out.extend_from_slice(&30u32.to_be_bytes());
	let mut srv = Vec::new();
	srv.extend_from_slice(&0u16.to_be_bytes()); // priority
	srv.extend_from_slice(&0u16.to_be_bytes()); // weight
	srv.extend_from_slice(&port.to_be_bytes());
	dns_name(host, &mut srv);
	out.extend_from_slice(&(srv.len() as u16).to_be_bytes());
	out.extend_from_slice(&srv);

	// TXT: stable workstation identity + user-visible name.
	dns_name(service, &mut out);
	out.extend_from_slice(&16u16.to_be_bytes());
	out.extend_from_slice(&0x8001u16.to_be_bytes());
	out.extend_from_slice(&30u32.to_be_bytes());

	let txt_items = [
		format!("id={}", discovery_service_id()),
		format!("name={}", hostname_string()),
		format!("a={ip}:{LEGACY_PORT}"),
		format!("av2={ip}:{PORT}"),
		format!("t={}", pairing_token()),
	];

	let mut txt = Vec::new();
	for item in txt_items {
		if item.len() <= 255 {
			txt.push(item.len() as u8);
			txt.extend_from_slice(item.as_bytes());
		}
	}

	out.extend_from_slice(&(txt.len() as u16).to_be_bytes());
	out.extend_from_slice(&txt);

	// A record.
	dns_name(host, &mut out);
	out.extend_from_slice(&1u16.to_be_bytes());
	out.extend_from_slice(&0x8001u16.to_be_bytes());
	out.extend_from_slice(&30u32.to_be_bytes());
	out.extend_from_slice(&4u16.to_be_bytes());
	out.extend_from_slice(&ip.octets());

	debug_assert!(service.starts_with(instance));

	out
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, prost::Enumeration)]
#[repr(i32)]
enum ImageFormat {
	Lzf = 0,
	Lzfse = 1,
	Lz4 = 2,
	Bmp = 3,
	Jpg = 4,
	Png = 5,
	Invalid = 100,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, prost::Enumeration)]
#[repr(i32)]
enum ImageType {
	Opaque = 0,
	Transparent = 1,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, prost::Enumeration)]
#[repr(i32)]
enum ErrorCode {
	DeviceNotFound = 0,
	DeviceNameAlreadyTaken = 1,
	ResourceLimitReached = 2,
	AuthenticationRejected = 3,
	Cancelled = 4,
	InvalidState = 5,
}

