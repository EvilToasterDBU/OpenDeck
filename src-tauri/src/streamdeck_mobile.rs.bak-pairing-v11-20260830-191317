	#[prost(enumeration = "ImageFormat", tag = "1")]
	format: i32,
	#[prost(enumeration = "ImageType", tag = "2")]
	r#type: i32,
	#[prost(message, optional, tag = "3")]
	size: Option<Size>,
	#[prost(uint32, tag = "4")]
	row_bytes: u32,
	#[prost(bytes = "vec", tag = "5")]
	image: Vec<u8>,
}

